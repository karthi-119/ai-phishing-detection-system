# PhishGuard AI Environment Configuration Example

# Server Environment (development | production)
ENVIRONMENT=development
DEBUG=false

# API Server Host & Port
API_HOST=127.0.0.1
API_PORT=8000

# Allowed CORS Frontend Origin
FRONTEND_ORIGIN=http://localhost:5173

# Trained ML Artifact Paths (Relative to repository root)
MODEL_PATH=ml/models/phishing_rf_model.pkl
FEATURE_COLS_PATH=ml/models/feature_columns.pkl
METADATA_PATH=ml/models/model_metadata.json
